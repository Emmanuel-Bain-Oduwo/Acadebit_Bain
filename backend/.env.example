# Server
PORT=8080
NODE_ENV=production

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/acadebit

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# ─── AI Providers ──────────────────────────────────────────────────────────────
# DeepSeek V4 Pro (primary text generation — lesson plans, exams, notes, etc.)
DEEPSEEK_API_KEY=sk-...

# OpenAI (fallback text generation)
OPENAI_API_KEY=sk-...

# Google Gemini (images/diagrams, podcast scripts, video content)
GEMINI_API_KEY=AIza...

# Kimi by Moonshot AI (complex reasoning, teacher voice assistant, analysis)
KIMI_API_KEY=sk-...

# ─── M-Pesa (Safaricom Daraja API) ────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-backend.railway.app/api/payments/mpesa/callback

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL
FRONTEND_URL=https://acadebit.vercel.app

# ─── File Storage ─────────────────────────────────────────────────────────────
# Local uploads dir (default). For production use R2/GCS and add cloud keys.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500
