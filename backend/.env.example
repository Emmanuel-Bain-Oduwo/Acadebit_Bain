# Server
PORT=8080
NODE_ENV=production

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/acadebit

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# M-Pesa (Safaricom Daraja API)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-backend.railway.app/api/payments/mpesa/callback

# CORS — set to your Vercel frontend URL
FRONTEND_URL=https://acadebit.vercel.app
